# Hawser environment configuration
# Managed by Ansible — do not edit manually

# Authentication (TOKEN_FILE takes precedence over TOKEN)
{% if hawser_token_file | length > 0 %}
TOKEN_FILE={{ hawser_token_file }}
{% else %}
TOKEN={{ hawser_token }}
{% endif %}

# Agent identification
{% if hawser_agent_id | length > 0 %}
AGENT_ID={{ hawser_agent_id }}
{% endif %}
{% if hawser_agent_name | length > 0 %}
AGENT_NAME={{ hawser_agent_name }}
{% endif %}

# Logging
LOG_LEVEL={{ hawser_log_level }}

# Docker connection
{% if hawser_docker_socket | length > 0 %}
DOCKER_SOCKET={{ hawser_docker_socket }}
{% endif %}
{% if hawser_docker_host | length > 0 %}
DOCKER_HOST={{ hawser_docker_host }}
{% endif %}

# Timeouts and intervals (seconds)
HEARTBEAT_INTERVAL={{ hawser_heartbeat_interval }}
REQUEST_TIMEOUT={{ hawser_request_timeout }}
COMPOSE_TIMEOUT={{ hawser_compose_timeout }}
RECONNECT_DELAY={{ hawser_reconnect_delay }}
MAX_RECONNECT_DELAY={{ hawser_max_reconnect_delay }}
WELCOME_TIMEOUT={{ hawser_welcome_timeout }}

# Max inbound WebSocket message size (MiB)
MAX_MESSAGE_SIZE_MB={{ hawser_max_message_size_mb }}

# Stack files directory
STACKS_DIR={{ hawser_stacks_dir }}
{% if hawser_mode == 'edge' %}

# Edge mode (outbound connection to Dockhand)
DOCKHAND_SERVER_URL={{ hawser_dockhand_url }}
{% if hawser_ca_cert | length > 0 %}
CA_CERT={{ hawser_ca_cert }}
{% endif %}
{% if hawser_tls_skip_verify | bool %}
TLS_SKIP_VERIFY=true
{% endif %}
{% else %}

# Standard mode (inbound listener)
BIND_ADDRESS={{ hawser_bind_address }}
PORT={{ hawser_port }}
{% if hawser_allow_insecure_no_auth | bool %}
ALLOW_INSECURE_NO_AUTH=true
{% endif %}
{% if hawser_tls_cert | length > 0 %}
TLS_CERT={{ hawser_tls_cert }}
TLS_KEY={{ hawser_tls_key }}
{% endif %}
{% endif %}
