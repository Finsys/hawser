[Unit]
Description=Hawser - Dockhand Remote Docker Agent
Documentation=https://github.com/Finsys/hawser
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User={{ hawser_user }}
Group={{ hawser_group }}
EnvironmentFile=/etc/hawser.env
ExecStart={{ hawser_install_dir }}/hawser{% if hawser_mode == 'standard' %} standard --port {{ hawser_port }}{% endif %}

Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# docker login, compose and buildx need a writable config dir and temp dir; /run/hawser is tmpfs.
RuntimeDirectory=hawser
Environment=DOCKER_CONFIG=/run/hawser TMPDIR=/run/hawser
PrivateTmp=true
ReadOnlyPaths=/
ReadWritePaths="{{ hawser_stacks_dir }}"

[Install]
WantedBy=multi-user.target
